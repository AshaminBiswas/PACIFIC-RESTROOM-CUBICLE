{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/products/kids-toilet",
      "destination": "/products/kids-cubicles",
      "permanent": true
    },
    {
      "source": "/products/kids-cubicle",
      "destination": "/products/kids-cubicles",
      "permanent": true
    },
    {
      "source": "/kids-cubicle",
      "destination": "/products/kids-cubicles",
      "permanent": true
    },
    {
      "source": "/cubicles",
      "destination": "/products/restroom-cubicles",
      "permanent": true
    },
    {
      "source": "/lockers",
      "destination": "/products/lockers",
      "permanent": true
    },
    {
      "source": "/urinal-partitions",
      "destination": "/products/urinal-partitions",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/nvidia/:path*",
      "destination": "/api/nvidia"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
