# ============================================================
# Pacific Products & Solutions — Environment Variables Template
# Copy this file to .env and replace the placeholder values.
# ============================================================

# ── Supabase Infrastructure ─────────────────────────────────
# Required for live database, auth, and cloud asset storage.
# If omitted or left empty, the application runs gracefully using
# offline in-memory demo data and mock authentication.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# ── Lead Generation & Forms ──────────────────────────────────
# Web3Forms access key for direct email notification dispatches
# from the 3D Cubicle Configurator and Contact forms.
VITE_WEB3FORMS_KEY=your-web3forms-access-key

# ── AI Chatbot (Aria) / NVIDIA NIM ──────────────────────────
# Server-side key for the NVIDIA NIM API proxy (/api/nvidia).
# In production on Vercel, set this in your Vercel Project Settings.
# In local development, the Vite dev proxy will forward requests
# with this Authorization header.
NVIDIA_API_KEY=nvapi-your-nvidia-api-key
